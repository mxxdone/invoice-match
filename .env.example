# Copy to .env and replace this placeholder with a unique local password.
POSTGRES_PASSWORD=replace-with-a-unique-local-password

# Shared secret for the signed mock-ERP result webhook. Replace with a unique
# local value; it is never committed or logged and never stored in a payload.
MOCK_ERP_WEBHOOK_SECRET=replace-with-a-unique-webhook-secret

# Optional host-port overrides. Container-to-container ports remain unchanged.
POSTGRES_PORT=5432
CORE_API_PORT=8080
WEB_PORT=3000
MOCK_ERP_PORT=8081
MOCK_PURCHASING_PORT=8082

# Phase 2 opt-in document storage (compose.storage.yaml).
# Replace both placeholders with unique local credentials.
MINIO_ROOT_USER=replace-with-a-unique-storage-user
MINIO_ROOT_PASSWORD=replace-with-a-unique-storage-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Core API document storage is disabled by default. For a local JVM use the
# localhost endpoint; Compose core-api uses http://minio:9000 internally.
DOCUMENT_STORAGE_ENABLED=false
DOCUMENT_STORAGE_ENDPOINT=http://localhost:9000
DOCUMENT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
DOCUMENT_STORAGE_ACCESS_KEY=replace-with-a-unique-storage-user
DOCUMENT_STORAGE_SECRET_KEY=replace-with-a-unique-storage-password
DOCUMENT_STORAGE_BUCKET=invoice-documents
DOCUMENT_STORAGE_REGION=us-east-1

# Optional analysis consumer (compose.analysis.yaml). Replace these values.
ANALYSIS_RABBIT_USERNAME=replace-with-a-unique-analysis-user
ANALYSIS_RABBIT_PASSWORD=replace-with-a-unique-analysis-password
ANALYSIS_WORKER_TOKEN=replace-with-a-unique-worker-token-at-least-32-characters
